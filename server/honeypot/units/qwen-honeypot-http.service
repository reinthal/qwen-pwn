[Unit]
Description=Qwen 3.8 call-home research honeypot (wildcard HTTP/HTTPS)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qwen-honey
Group=qwen-honey
DynamicUser=no
ExecStart=/usr/bin/python3 /opt/qwen-honeypot/honeypot_http.py
Restart=always
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/qwen-honeypot
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
UMask=0027
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
